{
  "name": "hakimi-deutan-theme",
  "version": "2.0.0",
  "description": "Deuteranopia-focused color tokens and themes for VS Code, Zed, and Obsidian",
  "type": "module",
  "keywords": [
    "colorblind",
    "accessibility",
    "deuteranopia",
    "deutan",
    "theme",
    "colorblind-safe",
    "accessible"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zogwosh/hakimi-theme.git"
  },
  "bugs": {
    "url": "https://github.com/zogwosh/hakimi-theme/issues"
  },
  "homepage": "https://github.com/zogwosh/hakimi-theme#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./palette.json": "./dist/palette.json",
    "./css": "./dist/hakimi-deuteranopia.css",
    "./scss": "./dist/hakimi-deuteranopia.scss",
    "./less": "./dist/hakimi-deuteranopia.less"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@vscode/vsce": "4.0.0"
  },
  "license": "MIT",
  "author": "hakimi",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/test.mjs && node scripts/verify-tokens.mjs",
    "test": "npm run build && npm run verify",
    "check": "npm test && npm run lint",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "package:vscode": "npm run check && node scripts/package-vscode.mjs",
    "install:zed": "node scripts/install-zed.mjs",
    "install:obsidian": "node scripts/install-obsidian.mjs",
    "package:npm": "npm run check && npm pack --ignore-scripts --pack-destination artifacts",
    "prepack": "npm run check"
  }
}
