{
  "name": "hakimi-deutan-theme",
  "version": "1.2.1",
  "publisher": "hakimi",
  "displayName": "Hakimi Deuteranopia Safe",
  "description": "A VSCode theme extension optimized specifically for deuteranopia (green-blindness) accessibility (Light and Dark versions)",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "colorblind",
    "accessibility",
    "deuteranopia",
    "deutan",
    "theme",
    "colorblind-safe",
    "accessible"
  ],
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zogwosh/hakimi-theme.git"
  },
  "bugs": {
    "url": "https://github.com/zogwosh/hakimi-theme/issues"
  },
  "homepage": "https://github.com/zogwosh/hakimi-theme#readme",
  "contributes": {
    "themes": [
      {
        "label": "Hakimi Deuteranopia Light",
        "uiTheme": "vs",
        "path": "./themes/hakimi-deuteranopia-light.json"
      },
      {
        "label": "Hakimi Deuteranopia Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/hakimi-deuteranopia-dark.json"
      }
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./palette.json": "./dist/palette.json",
    "./css": "./dist/hakimi-deuteranopia.css",
    "./scss": "./dist/hakimi-deuteranopia.scss",
    "./less": "./dist/hakimi-deuteranopia.less"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npx @vscode/vsce package",
    "test": "node scripts/test.mjs && node scripts/verify-consistency.mjs && node scripts/audit-deutan.mjs",
    "vscode:prepublish": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@bjornlu/colorblind": "^1.0.3"
  }
}