{
  "name": "Hakimi Colorblindness Dark Bright",
  "type": "dark",
  "colors": {
    "editor.background": "#121212",
    "editor.foreground": "#ffffff",
    "editorCursor.foreground": "#6aa6ff",
    "editor.lineHighlightBackground": "#1e1e1e",
    "editor.lineHighlightBorder": "#2a2a2a",
    "editorLineNumber.foreground": "#707070",
    "editorLineNumber.activeForeground": "#6aa6ff",
    "editorBracketMatch.background": "#40b0a640",
    "editorBracketMatch.border": "#40b0a6",

    "activityBar.background": "#181818",
    "activityBar.foreground": "#6aa6ff",
    "activityBar.inactiveForeground": "#b4b4ba",
    "activityBar.border": "#2a2a2a",

    "sideBar.background": "#181818",
    "sideBar.foreground": "#ffffff",
    "sideBar.border": "#2a2a2a",
    "sideBarTitle.foreground": "#6aa6ff",

    "statusBar.background": "#121212",
    "statusBar.foreground": "#b4b4ba",
    "statusBar.border": "#121212",

    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.border": "#2a2a2a",

    "tab.activeBackground": "#121212",
    "tab.activeForeground": "#6aa6ff",
    "tab.inactiveBackground": "#1a1a1a",
    "tab.inactiveForeground": "#b4b4ba",
    "tab.border": "#2a2a2a",

    "button.background": "#6aa6ff",
    "button.foreground": "#121212",
    "button.hoverBackground": "#785ef0",

    "input.background": "#1e1e1e",
    "input.foreground": "#ffffff",
    "input.border": "#2a2a2a",
    "input.placeholderForeground": "#b4b4ba"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#ff8f36",
    "type": "#ff8f36",
    "interface": "#ff8f36",
    "struct": "#ff8f36",
    "enum": "#ff8f36",
    "enumMember": "#ff8f36",
    "typeParameter": "#ff8f36",
    "type:defaultLibrary": "#ffffff",
    "class:defaultLibrary": "#80baff",
    "function": "#ffdd6e",
    "method": "#ffdd6e",
    "property": "#ffffff",
    "variable": "#ffffff",
    "parameter": "#ffffff",
    "keyword": "#80baff",
    "number": "#ff8f36",
    "string": "#a3e4ef"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused"
      ],
      "settings": {
        "foreground": "#b4b4ba",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#a3e4ef"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#80baff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#ffdd6e"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ff8f36"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff8f36"
      }
    },
    {
      "name": "Built-in Classes",
      "scope": [
        "support.class.builtin",
        "support.class.js",
        "support.class.ts"
      ],
      "settings": {
        "foreground": "#80baff"
      }
    },
    {
      "name": "Variables, Parameters & Properties",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.block variable.other",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#80baff"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#a3e4ef"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff8f8f",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Type Parameters and Brackets",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#ff8f36"
      }
    },
    {
      "name": "Primitive Types",
      "scope": [
        "support.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "JSON/YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#6aa6ff"
      }
    }
  ]
}
