{
  "name": "Hakimi Colorblindness Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "editorCursor.foreground": "#0a3d91",
    "editor.lineHighlightBackground": "#f5f6f8",
    "editor.lineHighlightBorder": "#e9ecef",
    "editorLineNumber.foreground": "#bbbbbb",
    "editorLineNumber.activeForeground": "#0a3d91",
    "editorBracketMatch.background": "#40b0a640",
    "editorBracketMatch.border": "#009e73",

    "activityBar.background": "#f8f9fa",
    "activityBar.foreground": "#0a3d91",
    "activityBar.inactiveForeground": "#6e6e6e",
    "activityBar.border": "#e9ecef",

    "sideBar.background": "#f8f9fa",
    "sideBar.foreground": "#000000",
    "sideBar.border": "#e9ecef",
    "sideBarTitle.foreground": "#0a3d91",

    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#6e6e6e",
    "statusBar.border": "#ffffff",

    "titleBar.activeBackground": "#f8f9fa",
    "titleBar.activeForeground": "#000000",
    "titleBar.border": "#e9ecef",

    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#0a3d91",
    "tab.inactiveBackground": "#f1f3f5",
    "tab.inactiveForeground": "#6e6e6e",
    "tab.border": "#e9ecef",

    "button.background": "#0a3d91",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#648fff",

    "input.background": "#ffffff",
    "input.foreground": "#000000",
    "input.border": "#e9ecef",
    "input.placeholderForeground": "#6e6e6e"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#7a2e00",
    "type": "#7a2e00",
    "interface": "#7a2e00",
    "struct": "#7a2e00",
    "enum": "#7a2e00",
    "enumMember": "#7a2e00",
    "typeParameter": "#7a2e00",
    "type:defaultLibrary": "#000000",
    "class:defaultLibrary": "#0a3d91",
    "function": "#c2570a",
    "method": "#c2570a",
    "property": "#000000",
    "variable": "#000000",
    "parameter": "#000000",
    "keyword": "#0a3d91",
    "number": "#7a2e00",
    "string": "#1d6fd0"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused"
      ],
      "settings": {
        "foreground": "#6e6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#1d6fd0"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#0a3d91",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#c2570a"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#7a2e00"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7a2e00"
      }
    },
    {
      "name": "Built-in Classes",
      "scope": [
        "support.class.builtin",
        "support.class.js",
        "support.class.ts"
      ],
      "settings": {
        "foreground": "#0a3d91"
      }
    },
    {
      "name": "Variables, Parameters & Properties",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.block variable.other",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#0a3d91"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#1d6fd0"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c4141a",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Type Parameters and Brackets",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#7a2e00"
      }
    },
    {
      "name": "Primitive Types",
      "scope": [
        "support.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "JSON/YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#0a3d91"
      }
    }
  ]
}
