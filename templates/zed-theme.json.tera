        "error": "#{{ light.error }}",
        "error.border": "#{{ light.error }}",
        "error.background": "#{{ light.error }}1a",
        "success": "#{{ light.success }}",
        "success.border": "#{{ light.success }}",
        "success.background": "#{{ light.success }}1a",
        "unreachable": "#{{ light.syn_comment }}a0",
        "unreachable.border": "#{{ light.error }}66",
        "unreachable.background": "#{{ light.error }}12",
        "players": [
          { "cursor": "#{{ light.primary }}", "selection": "#{{ light.primary }}33", "background": "#{{ light.primary }}" },
          { "cursor": "#{{ light.error }}", "selection": "#{{ light.error }}33", "background": "#{{ light.error }}" },
          { "cursor": "#{{ light.secondary }}", "selection": "#{{ light.secondary }}33", "background": "#{{ light.secondary }}" },
