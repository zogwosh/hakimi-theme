        "scrollbar.thumb.border": null,
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#{{ light.foreground }}14",
        "minimap.thumb.background": "#{{ light.primary }}26",
        "minimap.thumb.hover_background": "#{{ light.primary }}40",
        "minimap.thumb.active_background": "#{{ light.primary }}66",
        "minimap.thumb.border": null,
