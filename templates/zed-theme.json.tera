        "created.background": "#{{ light.success }}1a",
        "deleted": "#{{ light.error }}",
        "deleted.border": "#{{ light.error }}",
        "deleted.background": "#{{ light.error }}1a",
        "hidden": "#{{ light.syn_comment }}80",
