        "editor.document_highlight.read_background": "#{{ light.primary }}1a",
        "editor.document_highlight.write_background": "#{{ light.secondary }}24",
        "editor.indent_guide": "#{{ light.foreground }}1a",
        "editor.indent_guide_active": "#{{ light.primary }}66",
        "terminal.background": "#{{ light.surface_editor }}",
        "terminal.ansi.background": "#{{ light.surface_editor }}",
