---
whiskers:
  version: "2.9.0"
  filename: "zed/themes/hakimi-deuteranopia.json"
---
{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Hakimi Deuteranopia Safe",
  "author": "hakimi",
  "themes": [
    {
      "name": "Hakimi Deuteranopia Light",
      "appearance": "light",
      "style": {
        "accents": [
          "#{{ light.error }}",
          "#{{ light.secondary }}",
          "#{{ light.warning }}",
          "#{{ light.success }}",
          "#{{ light.info }}",
          "#{{ light.primary }}",
          "#{{ light.accent }}"
        ],
        "vim.mode.text": "#{{ light.surface_editor }}",
        "vim.normal.foreground": "#{{ light.surface_editor }}",
        "vim.helix_normal.foreground": "#{{ light.surface_editor }}",
        "vim.visual.foreground": "#{{ light.surface_editor }}",
        "vim.helix_select.foreground": "#{{ light.surface_editor }}",
        "vim.insert.foreground": "#{{ light.surface_editor }}",
        "vim.visual_line.foreground": "#{{ light.surface_editor }}",
        "vim.visual_block.foreground": "#{{ light.surface_editor }}",
        "vim.replace.foreground": "#{{ light.surface_editor }}",
        "vim.normal.background": "#{{ light.primary }}",
        "vim.helix_normal.background": "#{{ light.primary }}",
        "vim.visual.background": "#{{ light.secondary }}",
        "vim.helix_select.background": "#{{ light.secondary }}",
        "vim.insert.background": "#{{ light.success }}",
        "vim.visual_line.background": "#{{ light.secondary }}",
        "vim.visual_block.background": "#{{ light.accent }}",
        "vim.replace.background": "#{{ light.error }}",
        "background.appearance": "opaque",
        "border": "#{{ light.foreground }}1f",
        "border.variant": "#{{ light.primary }}33",
        "border.focused": "#{{ light.primary }}",
        "border.selected": "#{{ light.primary }}",
        "border.transparent": "#00000000",
        "border.disabled": "#{{ light.syn_comment }}40",
        "elevated_surface.background": "#{{ light.surface_raised }}",
        "surface.background": "#{{ light.surface_base }}",
        "background": "#{{ light.surface_raised }}",
        "element.background": "#{{ light.surface_input }}",
        "element.hover": "#{{ light.primary }}17",
        "element.active": "#{{ light.primary }}2b",
        "element.selected": "#{{ light.secondary }}24",
        "element.disabled": "#{{ light.syn_comment }}1c",
        "drop_target.background": "#{{ light.primary }}26",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#{{ light.primary }}14",
        "ghost_element.active": "#{{ light.primary }}29",
        "ghost_element.selected": "#{{ light.secondary }}24",
        "ghost_element.disabled": "#00000000",
        "text": "#{{ light.foreground }}",
        "text.muted": "#{{ light.syn_comment }}",
        "text.placeholder": "#{{ light.syn_comment }}a0",
        "text.disabled": "#{{ light.syn_comment }}66",
        "text.accent": "#{{ light.primary }}",
        "icon": "#{{ light.foreground }}",
        "icon.muted": "#{{ light.syn_comment }}",
        "icon.disabled": "#{{ light.syn_comment }}66",
        "icon.placeholder": "#{{ light.syn_comment }}a0",
        "icon.accent": "#{{ light.primary }}",
