    "table.headerBackground": "#{{ surface_base }}",
    "table.headerForeground": "#{{ foreground }}",
    "list.focusAndSelectionBackground": "#{{ surface_input }}"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#{{ syn_string }}",
    "class": "#{{ syn_type }}",
    "type": "#{{ syn_type }}",
    "interface": "#{{ syn_type }}",
    "struct": "#{{ syn_type }}",
    "enum": "#{{ syn_type }}",
    "enumMember": "#{{ syn_type }}",
    "typeParameter": "#{{ syn_type }}",
    "type:defaultLibrary": "#{{ foreground }}",
    "class:defaultLibrary": "#{{ syn_keyword }}",
    "function": "#{{ syn_function }}",
    "method": "#{{ syn_function }}",
    "macro": {
      "foreground": "#{{ syn_type }}",
      "fontStyle": "bold"
    },
    "property": "#{{ foreground }}",
    "property.readonly": "#{{ syn_type }}",
    "variable": "#{{ foreground }}",
    "variable.readonly": "#{{ syn_type }}",
    "variable.defaultLibrary": "#{{ syn_keyword }}",
    "parameter": "#{{ foreground }}",
    "keyword": {
      "foreground": "#{{ syn_keyword }}",
      "fontStyle": "bold"
    },
    "number": "#{{ syn_type }}",
    "string": "#{{ syn_string }}",

    "selfKeyword": {
      "foreground": "#{{ error }}"
    },
    "boolean": {
      "foreground": "#{{ syn_type }}"
    },
    "class:python": {
      "foreground": "#{{ syn_type }}"
    },
    "class.builtin:python": {
      "foreground": "#{{ syn_keyword }}"
    },
    "variable.typeHint:python": {
      "foreground": "#{{ syn_type }}"
    },
    "function.decorator:python": {
      "foreground": "#{{ syn_type }}"
    },
    "variable.readonly:javascript": {
      "foreground": "#{{ foreground }}"
    },
    "variable.readonly:typescript": {
      "foreground": "#{{ foreground }}"
    },
    "property.readonly:javascript": {
      "foreground": "#{{ foreground }}"
    },
    "property.readonly:typescript": {
      "foreground": "#{{ foreground }}"
    },
    "variable.readonly:javascriptreact": {
      "foreground": "#{{ foreground }}"
    },
    "variable.readonly:typescriptreact": {
      "foreground": "#{{ foreground }}"
    },
    "property.readonly:javascriptreact": {
      "foreground": "#{{ foreground }}"
    },
    "property.readonly:typescriptreact": {
      "foreground": "#{{ foreground }}"
    },
    "variable.readonly:scala": {
      "foreground": "#{{ foreground }}"
    },
    "type.defaultLibrary:go": {
      "foreground": "#{{ syn_keyword }}"
    },
    "variable.readonly.defaultLibrary:go": {
      "foreground": "#{{ syn_keyword }}"
    },
    "enumMember:haskell": {
      "foreground": "#{{ syn_function }}",
      "fontStyle": ""
    },
    "enum:haskell": {
      "foreground": "#{{ syn_type }}",
      "fontStyle": "italic"
    },
    "type:haskell": {
      "foreground": "#{{ syn_type }}",
      "fontStyle": "italic"
    },
    "class:haskell": {
      "foreground": "#{{ syn_type }}",
      "fontStyle": ""
    },
    "interface:haskell": {
      "foreground": "#{{ syn_keyword }}",
      "fontStyle": ""
    },
    "property:haskell": {
      "foreground": "#{{ syn_type }}",
      "fontStyle": "italic"
    },
    "macro:haskell": {
      "foreground": "#{{ syn_function }}",
      "fontStyle": ""
    },
    "typeParameter:haskell": {
      "foreground": "#{{ foreground }}",
      "fontStyle": ""
    },
    "variable:haskell": {
      "fontStyle": ""
    },
    "tomlArrayKey": {
      "foreground": "#{{ syn_function }}",
      "fontStyle": ""
    },
    "tomlTableKey": {
      "foreground": "#{{ syn_function }}",
      "fontStyle": ""
    },
    "builtinAttribute.attribute.library:rust": {
      "foreground": "#{{ syn_function }}"
    },
    "generic.attribute:rust": {
      "foreground": "#{{ foreground }}"
    },
    "constant.builtin.readonly:nix": {
      "foreground": "#{{ syn_keyword }}"
    },
    "heading": {
      "foreground": "#{{ error }}"
    },
    "text.emph": {
      "foreground": "#{{ error }}",
      "fontStyle": "italic"
    },
    "text.strong": {
      "foreground": "#{{ error }}",
      "fontStyle": "bold"
    },
    "text.math": {
      "foreground": "#{{ error }}"
    },
    "pol": {
      "foreground": "#{{ error }}"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused"
      ],
      "settings": {
        "foreground": "#{{ syn_comment }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#{{ syn_string }}"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces & Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#{{ syn_string }}"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#{{ syn_function }}"
      }
    },
    {
      "name": "Member Functions",
      "scope": [
        "entity.name.function.member",
        "variable.function.member",
        "support.function.member"
      ],
      "settings": {
        "foreground": "#{{ syn_function }}"
      }
    },
    {
      "name": "Macros & Decorators",
      "scope": [
        "entity.name.function.macro",
        "entity.name.other.preprocessor.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers & Language Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Read-only Constants & Enum Members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.class",
        "entity.name.interface",
        "support.class",
        "support.type",
        "support.type.primitive",
        "keyword.type",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.impl",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Built-in Classes",
      "scope": [
        "support.class.builtin",
        "support.class.js",
        "support.class.ts"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "source variable.parameter"
      ],
      "settings": {
        "foreground": "#{{ foreground }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Properties & Member Variables",
      "scope": [
        "variable.other.property",
        "source variable.other.property",
        "support.variable.property",
        "meta.property.object",
        "meta.object-literal.key",
        "entity.other.attribute-name.class.css",
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#{{ foreground }}"
      }
    },
    {
      "name": "General Local Variables",
      "scope": [
        "source variable.other.readwrite",
        "source variable.other",
        "source entity.name.variable"
      ],
      "settings": {
        "foreground": "#{{ foreground }}"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#{{ syn_string }}"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#{{ error }}",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Type Parameters and Brackets",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "JSON/YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#{{ primary }}"
      }
    },
    {
      "name": "Basic text & variable names (incl. leading punctuation)",
      "scope": [
        "text",
        "source",
        "variable.other.readwrite",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#{{ foreground }}"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#{{ syn_comment }}",
        "fontStyle": ""
      }
    },
    {
      "name": "Booleans, constants, numbers",
      "scope": [
        "entity.name.constant",
        "constant.language.boolean",
        "constant.language.false",
        "constant.language.true",
        "keyword.other.unit.user-defined",
        "keyword.other.unit.suffix.floating-point"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "scope": [
        "keyword.operator.word",
        "keyword.operator.new",
        "variable.language.super",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}",
        "fontStyle": ""
      }
    },
    {
      "scope": "entity.name.tag.documentation",
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "scope": [
        "meta.function-call.method",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#{{ syn_function }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.other.inherited-class",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum member",
      "scope": "meta.enum variable.other.readwrite",
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "Types",
      "scope": [
        "meta.type",
        "meta.type-alias"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.annotation variable.function",
        "meta.annotation variable.annotation.function",
        "meta.annotation punctuation.definition.annotation",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "scope": "meta.function.parameters",
      "settings": {
        "foreground": "#{{ foreground }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Built-ins",
      "scope": "support.function.builtin",
      "settings": {
        "foreground": "#{{ error }}"
      }
    },
    {
      "scope": "entity.other.attribute-name.documentation",
      "settings": {
        "foreground": "#{{ error }}"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": "punctuation.definition.directive",
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Property names (left hand assignments in json/yaml/css/less)",
      "scope": "support.type.property-name.less",
      "settings": {
        "foreground": "#{{ syn_function }}",
        "fontStyle": ""
      }
    },
    {
      "name": "This/Self keyword",
      "scope": [
        "variable.language.this",
        "variable.language.this punctuation.definition.variable"
      ],
      "settings": {
