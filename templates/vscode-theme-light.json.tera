---
whiskers:
  version: "2.9.0"
  filename: "vscode-themes/hakimi-deuteranopia-light.json"
---
{
  "name": "Hakimi Deuteranopia Light",
  "type": "light",
  "colors": {
    "focusBorder": "#{{ primary }}cc",
    "foreground": "#{{ foreground }}",
    "disabledForeground": "#{{ syn_comment }}99",
    "descriptionForeground": "#{{ syn_comment }}",
    "errorForeground": "#{{ error }}",
    "icon.foreground": "#{{ foreground }}",
    "sash.hoverBorder": "#{{ primary }}99",
    "selection.background": "#{{ primary }}26",
    "widget.border": "#{{ border_strong }}",
    "widget.shadow": "#00000024",
    "window.activeBorder": "#{{ border_strong }}",
    "window.inactiveBorder": "#{{ border_subtle }}",
    "textBlockQuote.background": "#{{ surface_base }}",
    "textBlockQuote.border": "#{{ border_subtle }}",
    "textCodeBlock.background": "#{{ surface_base }}",
    "textPreformat.background": "#{{ surface_base }}",
    "toolbar.hoverBackground": "#0000000d",
    "toolbar.activeBackground": "#00000014",
    "toolbar.hoverOutline": "#{{ border_subtle }}",
    "editorActionList.background": "#{{ surface_raised }}",
    "editorActionList.foreground": "#{{ foreground }}",
    "editorActionList.focusBackground": "#{{ primary }}26",
    "editorActionList.focusForeground": "#{{ foreground }}",

    "editor.background": "#{{ surface_editor }}",
    "editor.foreground": "#{{ foreground }}",
    "editorCursor.foreground": "#{{ primary }}",
    "editor.lineHighlightBackground": "#{{ surface_line }}",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#{{ tol_grey }}",
    "editorLineNumber.activeForeground": "#{{ primary }}",
    "editorBracketMatch.background": "#40b0a640",
    "editorBracketMatch.border": "#{{ success }}",
    "editorBracketHighlight.foreground1": "#{{ primary }}",
    "editorBracketHighlight.foreground2": "#{{ secondary }}",
    "editorBracketHighlight.foreground3": "#{{ success }}",
    "editorBracketHighlight.foreground4": "#{{ info }}",
    "editorBracketHighlight.foreground5": "#{{ accent }}",
    "editorBracketHighlight.foreground6": "#{{ primary }}",
    "editorBracketHighlight.unexpectedBracket.foreground": "#{{ error }}",

    "activityBar.background": "#{{ surface_base }}",
    "activityBar.foreground": "#{{ primary }}",
    "activityBar.inactiveForeground": "#{{ syn_comment }}",
    "activityBar.border": "#{{ border_strong }}",
    "activityBar.activeBackground": "#0000000a",
    "activityBar.activeBorder": "#{{ primary }}",
    "activityBar.activeFocusBorder": "#{{ primary }}",
    "activityBarBadge.background": "#{{ primary }}",
    "activityBarBadge.foreground": "#{{ surface_editor }}",
    "activityBarTop.background": "#{{ surface_base }}",
    "activityBarTop.activeBackground": "#0000000a",
    "activityBarTop.foreground": "#{{ primary }}",
    "activityBarTop.inactiveForeground": "#{{ syn_comment }}",

    "sideBar.background": "#{{ surface_base }}",
    "sideBar.foreground": "#{{ foreground }}",
    "sideBar.border": "#{{ border_strong }}",
    "sideBarTitle.background": "#{{ surface_base }}",
    "sideBarTitle.foreground": "#{{ primary }}",
    "sideBarTitle.border": "#{{ border_subtle }}",
    "sideBarSectionHeader.background": "#{{ surface_header }}",
    "sideBarSectionHeader.foreground": "#{{ foreground }}",
    "sideBarSectionHeader.border": "#{{ border_subtle }}",
    "sideBar.dropBackground": "#{{ primary }}1f",
    "sideBarStickyScroll.background": "#{{ surface_header }}",
    "sideBarStickyScroll.border": "#{{ border_subtle }}",
    "sideBarStickyScroll.shadow": "#00000024",

    "statusBar.background": "#{{ surface_base }}",
    "statusBar.foreground": "#{{ syn_comment }}",
    "statusBar.border": "#{{ border_strong }}",
    "statusBar.debuggingBackground": "#{{ primary }}",
    "statusBar.debuggingForeground": "#{{ surface_editor }}",
    "statusBarItem.errorBackground": "#{{ error }}",
    "statusBarItem.errorForeground": "#{{ surface_editor }}",
    "statusBarItem.warningBackground": "#{{ warning }}",
    "statusBarItem.warningForeground": "#{{ surface_editor }}",
    "statusBarItem.hoverBackground": "#00000012",

    "titleBar.activeBackground": "#{{ surface_base }}",
    "titleBar.activeForeground": "#{{ foreground }}",
    "titleBar.inactiveBackground": "#{{ surface_header }}",
    "titleBar.inactiveForeground": "#{{ syn_comment }}",
    "titleBar.border": "#{{ border_strong }}",

    "tab.activeBackground": "#{{ surface_tab_active }}",
    "tab.activeForeground": "#{{ primary }}",
    "tab.inactiveBackground": "#{{ surface_tab_inactive }}",
    "tab.inactiveForeground": "#{{ syn_comment }}",
    "tab.border": "#{{ border_strong }}",
    "tab.activeBorder": "#{{ primary }}",
    "tab.activeBorderTop": "#{{ primary }}",
    "tab.unfocusedActiveBackground": "#{{ surface_tab_active }}",
    "tab.unfocusedInactiveBackground": "#{{ surface_tab_inactive }}",
    "tab.hoverBackground": "#{{ surface_base }}",
    "tab.hoverForeground": "#{{ foreground }}",
    "editorGroup.border": "#{{ border_strong }}",
    "editorGroup.emptyBackground": "#{{ surface_editor }}",
    "editorGroupHeader.tabsBackground": "#{{ surface_header }}",
    "editorGroupHeader.noTabsBackground": "#{{ surface_header }}",
    "editorGroupHeader.tabsBorder": "#{{ border_strong }}",
    "editorGroupHeader.border": "#{{ border_strong }}",

    "button.background": "#{{ primary }}",
    "button.foreground": "#{{ surface_editor }}",
    "button.hoverBackground": "#{{ ibm_blue }}",
    "button.border": "#{{ primary }}",
    "button.secondaryBackground": "#{{ surface_input }}",
    "button.secondaryForeground": "#{{ foreground }}",
    "button.secondaryHoverBackground": "#{{ surface_base }}",
    "button.secondaryBorder": "#{{ border_strong }}",
    "checkbox.background": "#{{ surface_input }}",
    "checkbox.foreground": "#{{ foreground }}",
    "checkbox.border": "#{{ border_strong }}",
    "checkbox.selectBackground": "#{{ surface_base }}",
    "checkbox.selectBorder": "#{{ primary }}",
    "checkbox.disabled.background": "#{{ surface_base }}",
    "checkbox.disabled.foreground": "#{{ syn_comment }}",
    "radio.activeBackground": "#{{ surface_base }}",
    "radio.activeForeground": "#{{ foreground }}",
    "radio.activeBorder": "#{{ primary }}",
    "radio.inactiveBackground": "#{{ surface_input }}",
    "radio.inactiveForeground": "#{{ foreground }}",
    "radio.inactiveBorder": "#{{ border_strong }}",
    "radio.inactiveHoverBackground": "#0000000d",

    "dropdown.background": "#{{ surface_input }}",
    "dropdown.foreground": "#{{ foreground }}",
    "dropdown.border": "#{{ border_strong }}",
    "dropdown.listBackground": "#{{ surface_raised }}",

    "input.background": "#{{ surface_input }}",
    "input.foreground": "#{{ foreground }}",
    "input.border": "#{{ border_strong }}",
    "input.placeholderForeground": "#{{ syn_comment }}",
    "inputOption.activeBackground": "#{{ primary }}26",
    "inputOption.activeBorder": "#{{ primary }}",
    "inputOption.activeForeground": "#{{ foreground }}",
    "inputOption.hoverBackground": "#0000000d",
    "inputValidation.errorBackground": "#{{ error }}1f",
    "inputValidation.errorForeground": "#{{ foreground }}",
    "inputValidation.errorBorder": "#{{ error }}",
    "inputValidation.infoBackground": "#{{ info }}1f",
    "inputValidation.infoForeground": "#{{ foreground }}",
    "inputValidation.infoBorder": "#{{ info }}",
    "inputValidation.warningBackground": "#{{ warning }}1f",
    "inputValidation.warningForeground": "#{{ foreground }}",
    "inputValidation.warningBorder": "#{{ warning }}",

    "quickInput.background": "#{{ surface_raised }}",
    "quickInput.foreground": "#{{ foreground }}",
    "quickInputTitle.background": "#{{ surface_header }}",
    "quickInputList.focusBackground": "#{{ primary }}26",
    "quickInputList.focusForeground": "#{{ foreground }}",
    "quickInputList.focusIconForeground": "#{{ primary }}",
    "pickerGroup.border": "#{{ border_subtle }}",
    "pickerGroup.foreground": "#{{ primary }}",
    "keybindingLabel.background": "#0000000d",
    "keybindingLabel.foreground": "#{{ foreground }}",
    "keybindingLabel.border": "#0000001f",
    "keybindingLabel.bottomBorder": "#00000024",
    "keybindingTable.headerBackground": "#{{ surface_header }}",
    "keybindingTable.rowsBackground": "#0000000a",

    "editorError.foreground": "#{{ error }}",
    "editorWarning.foreground": "#{{ warning }}",
    "editorInfo.foreground": "#{{ info }}",
    "editorHint.foreground": "#{{ syn_comment }}",

    "gitDecoration.addedResourceForeground": "#{{ success }}",
    "gitDecoration.modifiedResourceForeground": "#{{ warning }}",
    "gitDecoration.deletedResourceForeground": "#{{ error }}",
    "gitDecoration.ignoredResourceForeground": "#{{ syn_comment }}80",
    "gitDecoration.conflictingResourceForeground": "#{{ warning }}",
    "gitDecoration.untrackedResourceForeground": "#{{ info }}",

    "scrollbar.shadow": "#00000000",
    "scrollbar.background": "#00000000",
    "scrollbarSlider.background": "#00000020",
    "scrollbarSlider.hoverBackground": "#00000040",
    "scrollbarSlider.activeBackground": "#00000060",

    "list.activeSelectionBackground": "#{{ primary }}26",
    "list.activeSelectionForeground": "#{{ foreground }}",
    "list.activeSelectionIconForeground": "#{{ foreground }}",
    "list.inactiveSelectionBackground": "#0000000d",
    "list.inactiveSelectionForeground": "#{{ foreground }}",
    "list.inactiveSelectionIconForeground": "#{{ foreground }}",
    "list.focusBackground": "#{{ primary }}1f",
    "list.focusForeground": "#{{ foreground }}",
    "list.focusOutline": "#{{ primary }}99",
    "list.focusAndSelectionOutline": "#{{ primary }}",
    "list.hoverBackground": "#0000000a",
    "list.hoverForeground": "#{{ foreground }}",
    "list.dropBackground": "#{{ primary }}1f",
    "list.highlightForeground": "#{{ primary }}",
    "list.focusHighlightForeground": "#{{ primary }}",
    "list.errorForeground": "#{{ error }}",
    "list.warningForeground": "#{{ warning }}",
    "listFilterWidget.background": "#{{ surface_raised }}",
    "listFilterWidget.outline": "#{{ primary }}",
    "listFilterWidget.noMatchesOutline": "#{{ error }}",
    "listFilterWidget.shadow": "#00000024",
    "list.filterMatchBackground": "#{{ primary }}1f",
    "list.filterMatchBorder": "#{{ primary }}66",
    "list.inactiveFocusBackground": "#0000000d",
    "list.inactiveFocusOutline": "#{{ primary }}66",
    "list.dropBetweenBackground": "#{{ primary }}",
    "tree.indentGuidesStroke": "#00000024",
    "tree.inactiveIndentGuidesStroke": "#00000014",
    "tree.tableOddRowsBackground": "#00000008",

    "editorIndentGuide.background": "#{{ foreground }}1a",
    "editorIndentGuide.activeBackground": "#{{ primary }}66",

    "editor.selectionBackground": "#{{ primary }}1a",
    "editor.findMatchBackground": "#{{ primary }}4d",
    "editor.findMatchHighlightBackground": "#{{ primary }}33",

    "panel.background": "#{{ surface_base }}",
    "panel.border": "#{{ border_strong }}",
    "panel.dropBorder": "#{{ primary }}",
    "panelTitle.activeBorder": "#{{ primary }}",
    "panelTitle.activeForeground": "#{{ foreground }}",
    "panelTitle.inactiveForeground": "#{{ syn_comment }}",
    "panelTitle.border": "#{{ border_subtle }}",
    "panelTitleBadge.background": "#{{ primary }}",
    "panelTitleBadge.foreground": "#{{ surface_editor }}",
    "panelInput.border": "#{{ border_strong }}",
    "panelSection.border": "#{{ border_subtle }}",
    "panelSectionHeader.background": "#{{ surface_header }}",
    "panelSectionHeader.foreground": "#{{ foreground }}",
    "panelSectionHeader.border": "#{{ border_subtle }}",
    "panelStickyScroll.background": "#{{ surface_header }}",
    "panelStickyScroll.border": "#{{ border_subtle }}",
    "panelStickyScroll.shadow": "#00000024",
    "outputView.background": "#{{ surface_editor }}",
    "outputViewStickyScroll.background": "#{{ surface_header }}",

    "editorWidget.background": "#{{ surface_raised }}",
    "editorWidget.foreground": "#{{ foreground }}",
    "editorWidget.border": "#{{ border_strong }}",
    "editorWidget.resizeBorder": "#{{ primary }}",
    "editorSuggestWidget.background": "#{{ surface_raised }}",
    "editorSuggestWidget.foreground": "#{{ foreground }}",
    "editorSuggestWidget.border": "#{{ border_strong }}",
    "editorSuggestWidget.selectedBackground": "#{{ primary }}26",
    "editorSuggestWidget.selectedForeground": "#{{ foreground }}",
    "editorSuggestWidget.selectedIconForeground": "#{{ primary }}",
    "editorSuggestWidget.highlightForeground": "#{{ primary }}",
    "editorSuggestWidget.focusHighlightForeground": "#{{ primary }}",
    "editorSuggestWidgetStatus.foreground": "#{{ syn_comment }}",
    "editorHoverWidget.background": "#{{ surface_raised }}",
    "editorHoverWidget.foreground": "#{{ foreground }}",
    "editorHoverWidget.border": "#{{ border_strong }}",
    "editorHoverWidget.statusBarBackground": "#{{ surface_header }}",
    "editorHoverWidget.highlightForeground": "#{{ primary }}",
    "editorStickyScroll.background": "#{{ surface_header }}",
    "editorStickyScrollGutter.background": "#{{ surface_editor }}",
    "editorStickyScrollHover.background": "#{{ surface_base }}",
    "editorStickyScroll.border": "#{{ border_subtle }}",
    "editorStickyScroll.shadow": "#00000024",
    "debugExceptionWidget.background": "#{{ surface_raised }}",
    "debugExceptionWidget.border": "#{{ error }}",
    "editorMarkerNavigation.background": "#{{ surface_raised }}",
    "editorMarkerNavigationError.background": "#{{ error }}",
    "editorMarkerNavigationWarning.background": "#{{ warning }}",
    "editorMarkerNavigationInfo.background": "#{{ info }}",

    "peekView.border": "#{{ primary }}",
    "peekViewEditor.background": "#{{ surface_editor }}",
    "peekViewEditor.matchHighlightBackground": "#{{ primary }}33",
    "peekViewEditorGutter.background": "#{{ surface_base }}",
    "peekViewResult.background": "#{{ surface_base }}",
    "peekViewResult.fileForeground": "#{{ foreground }}",
    "peekViewResult.lineForeground": "#{{ syn_comment }}",
    "peekViewResult.matchHighlightBackground": "#{{ primary }}33",
    "peekViewResult.selectionBackground": "#{{ primary }}26",
    "peekViewResult.selectionForeground": "#{{ foreground }}",
    "peekViewTitle.background": "#{{ surface_header }}",
    "peekViewTitleDescription.foreground": "#{{ syn_comment }}",
    "peekViewTitleLabel.foreground": "#{{ foreground }}",

    "debugToolBar.background": "#{{ surface_raised }}",
    "debugToolBar.border": "#{{ border_strong }}",

    "menubar.selectionForeground": "#{{ foreground }}",
    "menubar.selectionBackground": "#{{ primary }}1f",
    "menubar.selectionBorder": "#{{ primary }}66",
    "menu.background": "#{{ surface_raised }}",
    "menu.foreground": "#{{ foreground }}",
    "menu.selectionBackground": "#{{ primary }}26",
    "menu.selectionForeground": "#{{ foreground }}",
    "menu.selectionBorder": "#{{ primary }}66",
    "menu.separatorBackground": "#{{ border_subtle }}",
    "menu.border": "#{{ border_strong }}",
    "commandCenter.background": "#{{ surface_input }}",
    "commandCenter.foreground": "#{{ foreground }}",
    "commandCenter.activeBackground": "#{{ primary }}1f",
    "commandCenter.activeForeground": "#{{ foreground }}",
    "commandCenter.border": "#{{ border_strong }}",
    "commandCenter.inactiveForeground": "#{{ syn_comment }}",
    "commandCenter.inactiveBorder": "#{{ border_subtle }}",
    "commandCenter.activeBorder": "#{{ primary }}",
    "commandCenter.debuggingBackground": "#{{ primary }}26",

    "notificationCenter.border": "#{{ border_strong }}",
    "notificationCenterHeader.background": "#{{ surface_header }}",
    "notificationCenterHeader.foreground": "#{{ foreground }}",
    "notificationToast.border": "#{{ border_strong }}",
    "notifications.background": "#{{ surface_raised }}",
    "notifications.foreground": "#{{ foreground }}",
    "notifications.border": "#{{ border_strong }}",
    "notificationLink.foreground": "#{{ primary }}",
    "notificationsErrorIcon.foreground": "#{{ error }}",
    "notificationsWarningIcon.foreground": "#{{ warning }}",
    "notificationsInfoIcon.foreground": "#{{ info }}",
    "banner.background": "#{{ surface_base }}",
    "banner.foreground": "#{{ foreground }}",
    "banner.iconForeground": "#{{ primary }}",

    "settings.headerForeground": "#{{ primary }}",
    "settings.modifiedItemIndicator": "#{{ primary }}",
    "settings.dropdownBackground": "#{{ surface_input }}",
    "settings.dropdownForeground": "#{{ foreground }}",
    "settings.dropdownBorder": "#{{ border_strong }}",
    "settings.dropdownListBorder": "#{{ border_strong }}",
    "settings.checkboxBackground": "#{{ surface_input }}",
    "settings.checkboxForeground": "#{{ foreground }}",
    "settings.checkboxBorder": "#{{ border_strong }}",
    "settings.rowHoverBackground": "#0000000a",
    "settings.textInputBackground": "#{{ surface_input }}",
    "settings.textInputForeground": "#{{ foreground }}",
    "settings.textInputBorder": "#{{ border_strong }}",
    "settings.numberInputBackground": "#{{ surface_input }}",
    "settings.numberInputForeground": "#{{ foreground }}",
    "settings.numberInputBorder": "#{{ border_strong }}",
    "settings.focusedRowBackground": "#{{ primary }}1f",
    "settings.focusedRowBorder": "#{{ primary }}66",
    "settings.headerBorder": "#{{ border_subtle }}",
    "settings.sashBorder": "#{{ border_strong }}",
    "settings.settingsHeaderHoverForeground": "#{{ foreground }}",

    "breadcrumb.background": "#{{ surface_base }}",
    "breadcrumb.foreground": "#{{ syn_comment }}",
    "breadcrumb.focusForeground": "#{{ foreground }}",
    "breadcrumb.activeSelectionForeground": "#{{ primary }}",
    "breadcrumbPicker.background": "#{{ surface_raised }}",

    "welcomePage.background": "#{{ surface_editor }}",
    "welcomePage.tileBackground": "#{{ surface_base }}",
    "welcomePage.tileHoverBackground": "#0000000d",
    "welcomePage.progress.background": "#{{ surface_base }}",
    "welcomePage.progress.foreground": "#{{ primary }}",
    "walkThrough.embeddedEditorBackground": "#{{ surface_editor }}",

    "inlineChat.background": "#{{ surface_raised }}",
    "inlineChat.foreground": "#{{ foreground }}",
    "inlineChat.border": "#{{ border_strong }}",
    "inlineChat.shadow": "#00000024",
    "inlineChatInput.background": "#{{ surface_input }}",
    "inlineChatInput.border": "#{{ border_strong }}",
    "inlineChatInput.focusBorder": "#{{ primary }}",
    "inlineChatInput.placeholderForeground": "#{{ syn_comment }}",

    "terminal.background": "#{{ surface_editor }}",
    "terminal.foreground": "#{{ foreground }}",
    "terminal.tab.activeBorder": "#{{ primary }}",

    "terminal.ansiBlack": "#{{ foreground }}",
    "terminal.ansiRed": "#{{ error }}",
    "terminal.ansiGreen": "#{{ success }}",
    "terminal.ansiYellow": "#{{ warning }}",
    "terminal.ansiBlue": "#004b8f",
    "terminal.ansiMagenta": "#7a255d",
    "terminal.ansiCyan": "#005b6f",
    "terminal.ansiWhite": "#{{ foreground }}",
    "terminal.ansiBrightBlack": "#555555",
    "terminal.ansiBrightRed": "#{{ error }}",
    "terminal.ansiBrightGreen": "#{{ success }}",
    "terminal.ansiBrightYellow": "#{{ warning }}",
    "terminal.ansiBrightBlue": "#005b9f",
    "terminal.ansiBrightMagenta": "#7a255d",
    "terminal.ansiBrightCyan": "#005b6f",
    "terminal.ansiBrightWhite": "#{{ foreground }}"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#{{ syn_string }}",
    "class": "#{{ syn_type }}",
    "type": "#{{ syn_type }}",
    "interface": "#{{ syn_type }}",
    "struct": "#{{ syn_type }}",
    "enum": "#{{ syn_type }}",
    "enumMember": "#{{ syn_type }}",
    "typeParameter": "#{{ syn_type }}",
    "type:defaultLibrary": "#{{ foreground }}",
    "class:defaultLibrary": "#{{ syn_keyword }}",
    "function": "#{{ syn_function }}",
    "method": "#{{ syn_function }}",
    "macro": {
      "foreground": "#{{ syn_type }}",
      "fontStyle": "bold"
    },
    "property": "#{{ foreground }}",
    "property.readonly": "#{{ syn_type }}",
    "variable": "#{{ foreground }}",
    "variable.readonly": "#{{ syn_type }}",
    "variable.defaultLibrary": "#{{ syn_keyword }}",
    "parameter": "#{{ foreground }}",
    "keyword": {
      "foreground": "#{{ syn_keyword }}",
      "fontStyle": "bold"
    },
    "number": "#{{ syn_type }}",
    "string": "#{{ syn_string }}"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused"
      ],
      "settings": {
        "foreground": "#{{ syn_comment }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#{{ syn_string }}"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces & Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#{{ syn_string }}"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#{{ syn_function }}"
      }
    },
    {
      "name": "Member Functions",
      "scope": [
        "entity.name.function.member",
        "variable.function.member",
        "support.function.member"
      ],
      "settings": {
        "foreground": "#{{ syn_function }}"
      }
    },
    {
      "name": "Macros & Decorators",
      "scope": [
        "entity.name.function.macro",
        "entity.name.other.preprocessor.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers & Language Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Read-only Constants & Enum Members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.class",
        "entity.name.interface",
        "support.class",
        "support.type",
        "support.type.primitive",
        "keyword.type",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.impl",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "Built-in Classes",
      "scope": [
        "support.class.builtin",
        "support.class.js",
        "support.class.ts"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "source variable.parameter"
      ],
      "settings": {
        "foreground": "#{{ foreground }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Properties & Member Variables",
      "scope": [
        "variable.other.property",
        "source variable.other.property",
        "support.variable.property",
        "meta.property.object",
        "meta.object-literal.key",
        "entity.other.attribute-name.class.css",
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#{{ foreground }}"
      }
    },
    {
      "name": "General Local Variables",
      "scope": [
        "source variable.other.readwrite",
        "source variable.other",
        "source entity.name.variable"
      ],
      "settings": {
        "foreground": "#{{ foreground }}"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#{{ syn_keyword }}"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#{{ syn_string }}"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#{{ error }}",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Type Parameters and Brackets",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#{{ syn_type }}"
      }
    },
    {
      "name": "JSON/YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#{{ primary }}"
      }
    }
  ]
}
