        "foreground": "#{{ error }}",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#{{ error }}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "foreground": "#{{ syn_comment }}",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown auto links",
      "scope": [
        "punctuation.definition.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#{{ syn_function }}"
      }
    },
