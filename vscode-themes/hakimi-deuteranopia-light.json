  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#004b8f",
    "class": "#4a250e",
    "type": "#4a250e",
    "interface": "#4a250e",
    "struct": "#4a250e",
    "enum": "#4a250e",
    "enumMember": "#4a250e",
    "typeParameter": "#4a250e",
    "type:defaultLibrary": "#45494c",
    "class:defaultLibrary": "#4c6698",
    "function": "#704400",
    "method": "#704400",
    "macro": "#4a250e",
    "property": "#45494c",
    "property.readonly": "#4a250e",
    "variable": "#45494c",
    "variable.readonly": "#4a250e",
    "variable.defaultLibrary": "#4c6698",
    "parameter": "#45494c",
    "keyword": "#4c6698",
    "number": "#4a250e",
    "string": "#004b8f"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused"
      ],
      "settings": {
        "foreground": "#6f706f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#004b8f"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4c6698"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#4c6698",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces & Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#004b8f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#704400"
      }
    },
    {
      "name": "Member Functions",
      "scope": [
        "entity.name.function.member",
        "variable.function.member",
        "support.function.member"
      ],
      "settings": {
        "foreground": "#704400"
      }
    },
    {
      "name": "Macros & Decorators",
      "scope": [
        "entity.name.function.macro",
        "entity.name.other.preprocessor.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#4a250e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers & Language Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#4a250e"
      }
    },
    {
      "name": "Read-only Constants & Enum Members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#4a250e"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.class",
        "entity.name.interface",
        "support.class",
        "support.type",
        "support.type.primitive",
        "keyword.type",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.impl",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "entity.name.type.alias",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4a250e"
      }
    },
    {
      "name": "Built-in Classes",
      "scope": [
        "support.class.builtin",
        "support.class.js",
        "support.class.ts"
      ],
      "settings": {
        "foreground": "#4c6698"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "source variable.parameter"
      ],
      "settings": {
        "foreground": "#45494c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Properties & Member Variables",
      "scope": [
        "variable.other.property",
        "source variable.other.property",
        "support.variable.property",
        "meta.property.object",
        "meta.object-literal.key",
        "entity.other.attribute-name.class.css",
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#45494c"
      }
    },
    {
      "name": "General Local Variables",
      "scope": [
        "source variable.other.readwrite",
        "source variable.other",
        "source entity.name.variable"
      ],
      "settings": {
        "foreground": "#45494c"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#4c6698"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#004b8f"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#6f1f65",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Type Parameters and Brackets",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#4a250e"
      }
    },
    {
      "name": "JSON/YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4c6698"
      }
    }
  ]
}
