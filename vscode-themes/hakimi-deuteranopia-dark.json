  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#80dcff",
    "class": "#ff9536",
    "type": "#ff9536",
    "interface": "#ff9536",
    "struct": "#ff9536",
    "enum": "#ff9536",
    "enumMember": "#ff9536",
    "typeParameter": "#ff9536",
    "type:defaultLibrary": "#e0e0e0",
    "class:defaultLibrary": "#7ab2ff",
    "function": "#f0d68f",
    "method": "#f0d68f",
    "macro": "#ff9536",
    "property": "#e0e0e0",
    "property.readonly": "#ff9536",
    "variable": "#e0e0e0",
    "variable.readonly": "#ff9536",
    "variable.defaultLibrary": "#7ab2ff",
    "parameter": "#e0e0e0",
    "keyword": "#7ab2ff",
    "number": "#ff9536",
    "string": "#80dcff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused"
      ],
      "settings": {
        "foreground": "#99a0a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#80dcff"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7ab2ff"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7ab2ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces & Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#80dcff"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#f0d68f"
      }
    },
    {
      "name": "Member Functions",
      "scope": [
        "entity.name.function.member",
        "variable.function.member",
        "support.function.member"
      ],
      "settings": {
        "foreground": "#f0d68f"
      }
    },
    {
      "name": "Macros & Decorators",
      "scope": [
        "entity.name.function.macro",
        "entity.name.other.preprocessor.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#ff9536",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers & Language Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#ff9536"
      }
    },
    {
      "name": "Read-only Constants & Enum Members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#ff9536"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.class",
        "entity.name.interface",
        "support.class",
        "support.type",
        "support.type.primitive",
        "keyword.type",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.impl",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "entity.name.type.alias",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff9536"
      }
    },
    {
      "name": "Built-in Classes",
      "scope": [
        "support.class.builtin",
        "support.class.js",
        "support.class.ts"
      ],
      "settings": {
        "foreground": "#7ab2ff"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "source variable.parameter"
      ],
      "settings": {
        "foreground": "#e0e0e0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Properties & Member Variables",
      "scope": [
        "variable.other.property",
        "source variable.other.property",
        "support.variable.property",
        "meta.property.object",
        "meta.object-literal.key",
        "entity.other.attribute-name.class.css",
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "name": "General Local Variables",
      "scope": [
        "source variable.other.readwrite",
        "source variable.other",
        "source entity.name.variable"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#7ab2ff"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#80dcff"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff8585",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Type Parameters and Brackets",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#ff9536"
      }
